# spec: inline response handler `> {% ... %}`, multi-line and single-line
### capture-token
POST https://example.com/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials

> {%
    client.test("got a token", function() {
        client.assert(response.status === 200, "expected 200");
    });
    client.global.set("authToken", response.body.access_token);
%}
### one-liner
GET https://example.com/ping

> {% client.log("pong"); %}
